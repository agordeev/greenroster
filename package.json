{
  "name": "greenroster",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.6.3",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev:web": "pnpm --filter @greenroster/web dev",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "db:local-legal": "supabase db query --local --file scripts/seed-local-legal.sql",
    "db:demo": "pnpm db:local-legal && supabase db query --local --file scripts/seed-local-demo.sql",
    "db:test": "supabase test db --local",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "build": "pnpm -r --if-present build",
    "check": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "security:audit": "pnpm audit --audit-level high"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "supabase": "2.109.1",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "1.1.21",
      "brace-expansion@5": "5.0.12",
      "fast-uri": "3.1.8",
      "postcss": "8.5.31",
      "nanoid@3": "3.3.20",
      "source-map-js": "1.2.2",
      "js-yaml@4": "4.3.2",
      "engine.io": "6.6.11",
      "sharp": "0.35.5",
      "uuid": "11.1.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
