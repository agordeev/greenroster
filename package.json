{
  "name": "greenroster",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.6.3",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev:web": "pnpm --filter @greenroster/web dev",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "db:local-legal": "supabase db query --local --file scripts/seed-local-legal.sql",
    "db:demo": "pnpm db:local-legal && supabase db query --local --file scripts/seed-local-demo.sql",
    "db:test": "supabase test db --local",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "build": "pnpm -r --if-present build",
    "check": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "security:audit": "pnpm audit --audit-level high"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "supabase": "2.109.1",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1.1.16": "1.1.18",
      "brace-expansion@5.0.8": "5.0.9",
      "fast-uri": "3.1.5",
      "postcss": "8.5.23",
      "sharp": "0.35.0",
      "uuid": "11.1.1"
    }
  }
}
